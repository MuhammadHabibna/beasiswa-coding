---
import { pijak2027 } from '../data/programs';
const { timeline } = pijak2027;
---

<section id="timeline" class="bg-white py-20 px-4 fade-in-up border-b border-slate-200/80">
    <div class="max-w-3xl mx-auto px-2 sm:px-4">
        
        <div class="text-center mb-16">
            <div class="badge-pill-blue mb-3">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                Agenda Kegiatan
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-dark-slate mb-3 tracking-tight">
                Timeline Pelaksanaan Pijak 2027
            </h2>
            <p class="text-subtle text-base sm:text-lg">Catat tanggal-tanggal penting agar tidak melewatkan setiap tahapan beasiswa.</p>
        </div>

        <div class="relative border-l-2 border-slate-200 ml-4 sm:ml-8 space-y-8">
            {timeline.map((item) => (
                <div class="ml-6 sm:ml-8 relative group">
                    <span class="absolute flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 bg-brand text-white rounded-full -left-[37px] sm:-left-[45px] ring-4 ring-white shadow-xs font-bold text-xs sm:text-sm z-20 group-hover:bg-primary transition-colors duration-200">
                        {item.step}
                    </span>
                    <div class="p-5 sm:p-6 bg-white border border-slate-200 rounded-2xl shadow-xs hover:shadow-md hover:border-blue-200 transition-all duration-200 relative overflow-hidden group/card">
                        <div class="relative z-10">
                            <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                                <h3 class="text-lg sm:text-xl font-bold text-dark-slate">
                                    {item.title}
                                </h3>
                                {item.badge && (
                                    <span class="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-blue-50 text-primary border border-blue-200">
                                        {item.badge}
                                    </span>
                                )}
                            </div>
                            <time class="block mb-2.5 text-xs sm:text-sm font-bold text-primary flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                {item.date}
                            </time>
                            <p class="text-subtle text-xs sm:text-sm leading-relaxed font-normal">
                                {item.description}
                            </p>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <p class="mt-12 text-center text-xs font-medium text-slate-500 bg-slate-50 py-3 px-4 rounded-xl border border-slate-200/80 italic">
            *Timeline dapat berubah sewaktu-waktu. Selalu pantau email terdaftar Anda dan dashboard resmi Dicoding.
        </p>
    </div>
</section>
