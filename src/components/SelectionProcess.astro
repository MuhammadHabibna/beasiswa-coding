---
import { pijak2027 } from '../data/programs';
const { selectionSteps, deadlineISO } = pijak2027;
---

<section id="seleksi" class="bg-slate-50/70 py-20 px-4 relative overflow-hidden border-b border-slate-200/80">
    <div class="max-w-4xl mx-auto fade-in-up relative z-10 px-2 sm:px-4">
        
        <div class="text-center mb-16">
            <div class="badge-pill-blue mb-3">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                Alur Masuk Program
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-dark-slate tracking-tight mb-3">
                Tahapan Seleksi Pijak 2027
            </h2>
            <p class="text-subtle text-base sm:text-lg leading-relaxed">
                Pahami langkah demi langkah pendaftaran dan seleksi agar Anda berhasil terpilih menerima beasiswa.
            </p>
        </div>

        <!-- Dicoding Clean Card Container -->
        <div class="bg-white p-6 sm:p-10 rounded-2xl border border-slate-200/90 shadow-sm relative overflow-hidden">
            
            <!-- Top Header with countdown -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="h-9 w-2 bg-primary rounded-full"></div>
                    <div>
                        <h3 class="text-xl sm:text-2xl font-extrabold text-dark-slate tracking-tight">Alur Pendaftaran &amp; Seleksi</h3>
                        <p class="text-xs text-slate-500 font-semibold">Batas Pendaftaran: 31 Desember 2026</p>
                    </div>
                </div>
                
                <div class="badge-pill-red px-3.5 py-1.5 shrink-0 self-start sm:self-auto font-mono">
                    <svg class="w-3.5 h-3.5 animate-spin-slow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>Sisa Waktu:</span>
                    <span class="countdown-timer font-mono font-black" data-deadline={deadlineISO}>--h --j --m --s</span>
                </div>
            </div>

            <!-- Steps -->
            <div class="space-y-8 relative">
                <!-- Vertical Line -->
                <div class="absolute left-[1.15rem] top-4 bottom-4 w-0.5 bg-slate-200 hidden sm:block"></div>

                {selectionSteps.map((step) => (
                    <div class="flex relative group">
                        <div class="flex flex-col items-center mr-5 sm:mr-6 relative z-10 shrink-0">
                            <div class="flex items-center justify-center w-9 h-9 rounded-full border border-blue-200 bg-blue-50 text-primary font-extrabold text-sm shadow-xs group-hover:bg-primary group-hover:text-white group-hover:border-primary transition-all duration-200">
                                {step.step}
                            </div>
                        </div>
                        <div class="pb-1 flex-grow">
                            <h4 class="text-base sm:text-lg font-bold text-dark-slate mb-1.5">{step.title}</h4>
                            <p class="text-subtle text-xs sm:text-sm leading-relaxed mb-3 font-normal">{step.description}</p>
                            
                            {step.points && (
                                <ul class="space-y-1.5 text-xs text-slate-700 font-medium bg-slate-50 p-3.5 rounded-xl border border-slate-100">
                                    {step.points.map((pt) => (
                                        <li class="flex items-start gap-2">
                                            <span class="text-primary font-bold">✓</span>
                                            <span>{pt}</span>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </div>
                    </div>
                ))}
            </div>

            <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                <p class="text-xs text-slate-500 font-medium">
                    *Peserta yang lolos seleksi wajib mengonfirmasi penawaran dalam 48 jam.
                </p>
                <a href={pijak2027.ctaLink} target="_blank" rel="noopener noreferrer" class="btn-dicoding-primary text-xs font-bold px-6 py-3 w-full sm:w-auto">
                    Mulai Pendaftaran Sekarang
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
            </div>

        </div>

    </div>
</section>

<script>
    function updateCountdowns() {
        const timers = document.querySelectorAll('.countdown-timer');
        if (!timers.length) return;
        
        const now = new Date().getTime();
        
        timers.forEach(timer => {
            const deadlineStr = timer.getAttribute('data-deadline');
            if(!deadlineStr) return;
            const deadline = new Date(deadlineStr).getTime();
            const distance = deadline - now;
            
            if (distance < 0) {
                timer.innerHTML = "DITUTUP";
                return;
            }
            
            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);
            
            timer.innerHTML = `${days}h ${hours.toString().padStart(2, '0')}j ${minutes.toString().padStart(2, '0')}m ${seconds.toString().padStart(2, '0')}s`;
        });
    }
    
    updateCountdowns();
    setInterval(updateCountdowns, 1000);
</script>
