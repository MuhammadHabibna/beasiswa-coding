---
---

<section id="certificates" class="bg-slate-50/70 py-20 px-4 relative overflow-hidden border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto relative z-10 fade-in-up px-2 sm:px-4">
        
        <div class="text-center mb-16 max-w-2xl mx-auto">
            <div class="badge-pill-blue mb-3">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                Bukti Keahlian Nyata
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-dark-slate mb-3 tracking-tight">
                Sertifikasi Kompetensi Industri
            </h2>
            <p class="text-subtle text-base sm:text-lg">
                Selesaikan kurikulum pembelajaran dan raih sertifikat kompetensi resmi dari Dicoding &amp; IBM SkillsBuild yang terverifikasi dan diakui oleh industri.
            </p>
        </div>

        <!-- Marquee / Scrolling Certificates with Dicoding Styling -->
        <div class="relative w-full overflow-hidden [mask-image:_linear-gradient(to_right,transparent_0,_black_96px,_black_calc(100%-96px),transparent_100%)]">
            <div class="animate-marquee flex gap-5 sm:gap-6 min-w-max hover:[animation-play-state:paused] py-3">
                
                <!-- Cert 1 -->
                <div class="w-[280px] sm:w-[350px] md:w-[380px] shrink-0 bg-white p-2.5 rounded-2xl shadow-xs border border-slate-200 hover:shadow-md hover:border-blue-300 transition-all duration-200 hover:-translate-y-1">
                    <img src="/images/sertif/sertifikat_course_184_4086292_170226043212_page-0001.jpg" alt="Sertifikat Dicoding" class="w-full h-auto rounded-xl" loading="lazy">
                </div>
                
                <!-- Cert 2 -->
                <div class="w-[280px] sm:w-[350px] md:w-[380px] shrink-0 bg-white p-2.5 rounded-2xl shadow-xs border border-slate-200 hover:shadow-md hover:border-blue-300 transition-all duration-200 hover:-translate-y-1">
                    <img src="/images/sertif/sertifikat_course_237_4086292_200126141258_page-0001.jpg" alt="Sertifikat Kelulusan" class="w-full h-auto rounded-xl" loading="lazy">
                </div>

                <!-- Cert 3 -->
                <div class="w-[280px] sm:w-[350px] md:w-[380px] shrink-0 bg-white p-2.5 rounded-2xl shadow-xs border border-slate-200 hover:shadow-md hover:border-blue-300 transition-all duration-200 hover:-translate-y-1">
                    <img src="/images/sertif/sertifikat_course_615_4086292_220924142522_page-0001.jpg" alt="Sertifikat Pelatihan" class="w-full h-auto rounded-xl" loading="lazy">
                </div>

                <!-- Cert 4 -->
                <div class="w-[280px] sm:w-[350px] md:w-[380px] shrink-0 bg-white p-2.5 rounded-2xl shadow-xs border border-slate-200 hover:shadow-md hover:border-blue-300 transition-all duration-200 hover:-translate-y-1">
                    <img src="/images/sertif/sertifikat_course_653_4086292_020226120102_page-0001.jpg" alt="Sertifikat Kompetensi" class="w-full h-auto rounded-xl" loading="lazy">
                </div>

                <!-- Cert 5 -->
                <div class="w-[280px] sm:w-[350px] md:w-[380px] shrink-0 bg-white p-2.5 rounded-2xl shadow-xs border border-slate-200 hover:shadow-md hover:border-blue-300 transition-all duration-200 hover:-translate-y-1">
                    <img src="/images/sertif/sertifikat_course_86_4086292_060226231344_page-0001.jpg" alt="Sertifikat Penyelesaian" class="w-full h-auto rounded-xl" loading="lazy">
                </div>

                 <!-- Duplicates for seamless loop -->
                 <div class="w-[280px] sm:w-[350px] md:w-[380px] shrink-0 bg-white p-2.5 rounded-2xl shadow-xs border border-slate-200 hover:shadow-md hover:border-blue-300 transition-all duration-200 hover:-translate-y-1">
                    <img src="/images/sertif/sertifikat_course_184_4086292_170226043212_page-0001.jpg" alt="Sertifikat Dicoding" class="w-full h-auto rounded-xl" loading="lazy">
                </div>
                
                <div class="w-[280px] sm:w-[350px] md:w-[380px] shrink-0 bg-white p-2.5 rounded-2xl shadow-xs border border-slate-200 hover:shadow-md hover:border-blue-300 transition-all duration-200 hover:-translate-y-1">
                    <img src="/images/sertif/sertifikat_course_237_4086292_200126141258_page-0001.jpg" alt="Sertifikat Kelulusan" class="w-full h-auto rounded-xl" loading="lazy">
                </div>

                <div class="w-[280px] sm:w-[350px] md:w-[380px] shrink-0 bg-white p-2.5 rounded-2xl shadow-xs border border-slate-200 hover:shadow-md hover:border-blue-300 transition-all duration-200 hover:-translate-y-1">
                    <img src="/images/sertif/sertifikat_course_615_4086292_220924142522_page-0001.jpg" alt="Sertifikat Pelatihan" class="w-full h-auto rounded-xl" loading="lazy">
                </div>

                <div class="w-[280px] sm:w-[350px] md:w-[380px] shrink-0 bg-white p-2.5 rounded-2xl shadow-xs border border-slate-200 hover:shadow-md hover:border-blue-300 transition-all duration-200 hover:-translate-y-1">
                    <img src="/images/sertif/sertifikat_course_653_4086292_020226120102_page-0001.jpg" alt="Sertifikat Kompetensi" class="w-full h-auto rounded-xl" loading="lazy">
                </div>

                <div class="w-[280px] sm:w-[350px] md:w-[380px] shrink-0 bg-white p-2.5 rounded-2xl shadow-xs border border-slate-200 hover:shadow-md hover:border-blue-300 transition-all duration-200 hover:-translate-y-1">
                    <img src="/images/sertif/sertifikat_course_86_4086292_060226231344_page-0001.jpg" alt="Sertifikat Penyelesaian" class="w-full h-auto rounded-xl" loading="lazy">
                </div>
            </div>
        </div>

    </div>
</section>

<style>
    @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(calc(-50% - (1.25rem / 2))); }
    }
    .animate-marquee {
        animation: marquee 32s linear infinite;
    }
</style>
