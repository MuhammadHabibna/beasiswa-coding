---
import { pijak2027 } from '../data/programs';
---

<section class="relative bg-gradient-to-b from-[#e0f2fe]/40 via-[#f0f9ff]/30 to-[#fcfcfd] pt-32 pb-20 lg:pt-40 lg:pb-28 overflow-hidden border-b border-slate-200/70">
    <!-- Dicoding Subtle Mesh Glow & Dot Overlay -->
    <div class="absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:20px_20px] opacity-40 pointer-events-none z-0"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-b from-blue-300/25 to-transparent blur-3xl rounded-full pointer-events-none z-0"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center fade-in-up">
        
        <!-- Live Announcement Badge -->
        <a href="#tentang" class="inline-flex items-center justify-center px-4 py-1.5 mb-7 text-xs sm:text-sm font-bold text-[#065986] bg-white/90 backdrop-blur-md rounded-full border border-blue-200 shadow-xs hover:border-blue-300 transition-all duration-200">
            <span class="relative flex h-2.5 w-2.5 mr-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-primary"></span>
            </span>
            <span>🔥 Pendaftaran Terbuka: Beasiswa Pijak 2027 • Kuota 60.000 Peserta</span>
        </a>
        
        <!-- Main Headline -->
        <h1 class="mb-6 text-3xl sm:text-5xl lg:text-[4.1rem] font-extrabold tracking-tight text-dark-slate leading-[1.15] sm:leading-[1.15]">
            Raih <span class="text-primary">Beasiswa Coding &amp; AI</span> untuk Karier Masa Depan
        </h1>
        
        <!-- Subtitle -->
        <p class="mb-10 text-base sm:text-lg lg:text-xl font-normal text-subtle max-w-3xl mx-auto leading-relaxed">
            Portal informasi dan pendaftaran beasiswa coding &amp; teknologi berstandar global secara <strong class="text-dark-slate font-semibold">100% gratis</strong>. Saat ini dibuka program unggulan <strong class="text-primary font-bold">Pijak 2027</strong> kolaborasi <strong class="text-dark-slate font-semibold">IBM SkillsBuild &amp; Dicoding</strong> untuk mencetak 60.000 AI-Native Web Developer di Indonesia.
        </p>

        <!-- Metric Cards Strip -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 sm:gap-4 max-w-4xl mx-auto mb-10 text-left">
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-xs hover:shadow-sm transition-all duration-200">
                <div class="text-2xl sm:text-3xl font-black text-primary tracking-tight">60.000+</div>
                <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mt-1">Kuota Terbuka</div>
            </div>
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-xs hover:shadow-sm transition-all duration-200">
                <div class="text-2xl sm:text-3xl font-black text-brand tracking-tight">100%</div>
                <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mt-1">Gratis &amp; Online</div>
            </div>
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-xs hover:shadow-sm transition-all duration-200">
                <div class="text-2xl sm:text-3xl font-black text-indigo-600 tracking-tight">Global</div>
                <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mt-1">Standar Industri</div>
            </div>
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-xs hover:shadow-sm transition-all duration-200">
                <div class="text-2xl sm:text-3xl font-black text-emerald-600 tracking-tight">Resmi</div>
                <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mt-1">Sertifikat Kompetensi</div>
            </div>
        </div>
        
        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row justify-center items-center gap-3.5 sm:gap-4 w-full max-w-md sm:max-w-none mx-auto relative z-20">
            <a href={pijak2027.ctaLink} target="_blank" rel="noopener noreferrer" class="btn-dicoding-primary text-base px-7 py-3.5 w-full sm:w-auto shadow-md shadow-blue-500/20">
                <span>Daftar Beasiswa Pijak 2027</span>
                <svg class="w-4 h-4 ml-2 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            
            <a href="#programs" class="btn-dicoding-secondary text-base px-7 py-3.5 w-full sm:w-auto">
                <span>Jelajahi Katalog Beasiswa</span>
            </a>
        </div>
        
        <p class="mt-5 text-xs text-slate-500 font-medium flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Batas Pendaftaran Program Terbuka: <strong class="text-slate-700 font-bold">{pijak2027.deadline}</strong> • Registrasi resmi di Dicoding.com
        </p>

        <!-- Partner Logos Banner -->
        <div class="mt-14 pt-8 border-t border-slate-200/80 relative w-full overflow-hidden">
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-6 text-center">Mitra &amp; Ekosistem Inisiatif Beasiswa Teknologi</p>
            <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12 opacity-85 transition-all duration-300">
                <div class="flex items-center gap-1.5 font-bold text-xl tracking-tight text-slate-800">
                    <span class="font-mono text-2xl font-extrabold text-blue-700">IBM</span> SkillsBuild
                </div>
                <div class="h-5 w-px bg-slate-300 hidden sm:block"></div>
                <div class="flex items-center gap-1 font-extrabold text-xl tracking-tight text-brand">
                    <span>dicoding</span>
                </div>
                <div class="h-5 w-px bg-slate-300 hidden sm:block"></div>
                <div class="flex items-center gap-1.5 font-bold text-xl tracking-tight text-slate-800">
                    <span class="font-black text-amber-600">AWS</span> Training
                </div>
                <div class="h-5 w-px bg-slate-300 hidden sm:block"></div>
                <div class="flex items-center gap-1.5 font-bold text-xl tracking-tight text-slate-800">
                    <span class="font-extrabold text-blue-600">Microsoft</span> Elevate
                </div>
                <div class="h-5 w-px bg-slate-300 hidden sm:block"></div>
                <div class="flex items-center gap-1.5 font-bold text-xl tracking-tight text-slate-800">
                    <span class="font-black text-red-600">DBS</span> Foundation
                </div>
            </div>
        </div>

    </div>
</section>
