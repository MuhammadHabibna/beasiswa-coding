---
import { catalogPrograms } from '../data/programs';
import ProgramCard from './ProgramCard.astro';

const openCount = catalogPrograms.filter(p => p.status === 'open').length;
const upcomingCount = catalogPrograms.filter(p => p.status === 'upcoming').length;
---

<section id="programs" class="bg-slate-50/70 py-20 px-4 relative overflow-hidden border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto relative z-10 px-2 sm:px-4">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="badge-pill-blue mb-3.5">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        Direktori Beasiswa Terbuka
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-[2.6rem] font-extrabold text-dark-slate tracking-tight leading-tight mb-4">
        Katalog Program <span class="text-primary">Beasiswa Coding &amp; AI</span>
      </h2>
      <p class="text-subtle text-base sm:text-lg leading-relaxed">
        Pilih program beasiswa yang sesuai dengan minat dan tujuan karier digital Anda. Mulai dari yang sedang membuka pendaftaran hingga batch beasiswa mendatang bersama mitra teknologi global.
      </p>

      <!-- Filter / Summary Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-6">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold bg-white text-dark-slate border border-slate-200 shadow-xs">
          Total {catalogPrograms.length} Program Unggulan
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          {openCount} Sedang Buka Pendaftaran
        </span>
      </div>
    </div>

    <!-- Alert Box Penekanan Syarat Wajib -->
    <div class="mb-12 p-4 sm:p-6 rounded-2xl bg-gradient-to-r from-amber-500/10 via-orange-500/10 to-red-500/10 border-2 border-amber-400 shadow-sm max-w-4xl mx-auto text-left">
      <div class="flex items-start gap-3 sm:gap-4">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 text-white flex items-center justify-center shrink-0 shadow-sm mt-0.5">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-1.5">
            <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-md bg-rose-600 text-white shadow-2xs">PENTING</span>
            <h3 class="text-sm sm:text-base font-extrabold text-slate-900 tracking-tight">Kewajiban Penyelesaian Modul Awal agar Pendaftaran Terhitung Valid!</h3>
          </div>
          <p class="text-xs sm:text-sm text-slate-700 font-normal leading-relaxed mb-3">
            Mendaftar formulir saja tidak otomatis menjamin status kelulusan administrasi Anda. Anda <strong class="text-slate-900 font-bold">WAJIB</strong> menyelesaikan misi awal berikut agar status pendaftaran valid &amp; lolos verifikasi:
          </p>
          <div class="grid sm:grid-cols-2 gap-3 pt-0.5">
            <div class="p-3.5 rounded-xl bg-white border border-amber-300 shadow-2xs flex flex-col justify-between">
              <div>
                <span class="text-[11px] font-bold text-primary uppercase tracking-wider block mb-1">1. Program Pijak 2027</span>
                <p class="text-xs text-slate-800 leading-snug">
                  <strong class="text-rose-700 underline font-extrabold">WAJIB MENYELESAIKAN</strong> minimal <strong>1 (satu) course di IBM SkillsBuild</strong> setelah registrasi akun.
                </p>
              </div>
              <div class="mt-3 pt-2.5 border-t border-slate-100">
                <div class="flex items-center justify-between text-[10px] font-extrabold text-slate-600 uppercase tracking-wider mb-1">
                  <span>Contoh Tampilan di Dashboard:</span>
                  <a href="/images/pijak_misi_guide.jpg" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline font-bold lowercase">klik perbesar</a>
                </div>
                <a href="/images/pijak_misi_guide.jpg" target="_blank" rel="noopener noreferrer" class="block relative rounded-lg overflow-hidden border border-slate-200 group/img shadow-2xs">
                  <img src="/images/pijak_misi_guide.jpg" alt="Contoh Penyelesaian Course IBM SkillsBuild Pijak 2027" class="w-full h-32 sm:h-36 object-cover object-top group-hover/img:scale-105 transition-transform duration-300" loading="lazy" />
                  <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center justify-center text-white text-[11px] font-bold gap-1.5 backdrop-blur-2xs">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                    Buka Foto Contoh Lengkap
                  </div>
                </a>
              </div>
            </div>
            <div class="p-3.5 rounded-xl bg-white border border-amber-300 shadow-2xs flex flex-col justify-between">
              <div>
                <span class="text-[11px] font-bold text-red-600 uppercase tracking-wider block mb-1">2. AI Camp DBS Foundation</span>
                <p class="text-xs text-slate-800 leading-snug">
                  <strong class="text-rose-700 underline font-extrabold">WAJIB MENYELESAIKAN Misi 1</strong> di platform Bitt, yaitu minimal <strong>1 course Financial Literacy</strong> dan <strong>1 course Inspirational</strong>.
                </p>
              </div>
              <div class="mt-3 pt-2.5 border-t border-slate-100">
                <div class="flex items-center justify-between text-[10px] font-extrabold text-slate-600 uppercase tracking-wider mb-1">
                  <span>Contoh Tampilan di Dashboard:</span>
                  <a href="/images/dbs_aicamp_misi_guide.png" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline font-bold lowercase">klik perbesar</a>
                </div>
                <a href="/images/dbs_aicamp_misi_guide.png" target="_blank" rel="noopener noreferrer" class="block relative rounded-lg overflow-hidden border border-slate-200 group/img shadow-2xs">
                  <img src="/images/dbs_aicamp_misi_guide.png" alt="Contoh Pemilihan Kelas Misi 1 AI Camp DBS Foundation" class="w-full h-32 sm:h-36 object-cover object-top group-hover/img:scale-105 transition-transform duration-300" loading="lazy" />
                  <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center justify-center text-white text-[11px] font-bold gap-1.5 backdrop-blur-2xs">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                    Buka Foto Contoh Lengkap
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Programs Grid -->
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto items-stretch">
      {catalogPrograms.map((program) => (
        <ProgramCard {...program} />
      ))}
    </div>

    <!-- Extensibility Notice / Info Strip -->
    <div class="mt-12 p-4 sm:p-5 rounded-2xl bg-white border border-slate-200/90 shadow-xs max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-primary flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold text-dark-slate">Program Lain Akan Terus Ditambahkan</h4>
          <p class="text-xs text-subtle">Katalog ini terus diperbarui dengan program beasiswa coding, AI, dan pelatihan IT terbaru di Indonesia.</p>
        </div>
      </div>
      <a href="#tentang" class="btn-dicoding-secondary text-xs px-4 py-2 shrink-0 font-bold">
        Lihat Detail Program Aktif &darr;
      </a>
    </div>

  </div>
</section>
