---
import { pijak2027 } from '../data/programs';
---
<footer class="bg-[#0c111d] border-t border-slate-800 text-slate-400 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 lg:py-16">
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-slate-800/80">
            
            <!-- Col 1: Brand -->
            <div class="md:col-span-1 lg:col-span-1 space-y-3">
                <div class="flex items-center space-x-2.5">
                    <img src="/images/pijak_logo.svg" alt="Beasiswa Coding" class="w-7 h-7 rounded-lg object-contain" />
                    <span class="text-xl font-extrabold text-white tracking-tight">beasiswa<span class="text-primary font-bold">coding</span></span>
                </div>
                <p class="text-xs text-slate-400 max-w-sm leading-relaxed font-normal">
                    Portal direktori dan informasi beasiswa coding, Artificial Intelligence, dan pelatihan teknologi berstandar global di Indonesia.
                </p>
                <div class="pt-2 text-xs text-slate-500">
                    Program Terbuka: <span class="text-emerald-400 font-semibold">Pijak 2027 (Buka)</span>
                </div>
            </div>

            <!-- Col 2: Program Beasiswa -->
            <div>
                <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Program Beasiswa</h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="#tentang" class="hover:text-white transition-colors text-emerald-400 font-semibold flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Pijak 2027 (Sedang Buka)</a></li>
                    <li><a href="#programs" class="hover:text-white transition-colors">AWS AI Academy 2026</a></li>
                    <li><a href="#programs" class="hover:text-white transition-colors">Coding Camp 2.0 (DBS)</a></li>
                    <li><a href="#programs" class="hover:text-white transition-colors">Microsoft Elevate Center</a></li>
                    <li><a href="#programs" class="hover:text-white transition-colors text-slate-500">+ Program Mendatang</a></li>
                </ul>
            </div>

            <!-- Col 3: Navigasi -->
            <div>
                <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Navigasi Halaman</h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="#programs" class="hover:text-white transition-colors">Katalog Beasiswa</a></li>
                    <li><a href="#tentang" class="hover:text-white transition-colors">Program Unggulan Aktif</a></li>
                    <li><a href="#benefit" class="hover:text-white transition-colors">Benefit Beasiswa</a></li>
                    <li><a href="#path" class="hover:text-white transition-colors">Kurikulum Belajar</a></li>
                    <li><a href="#prasyarat" class="hover:text-white transition-colors">Prasyarat &amp; Perangkat</a></li>
                    <li><a href="#faq" class="hover:text-white transition-colors">FAQ / Tanya Jawab</a></li>
                </ul>
            </div>

            <!-- Col 4: Link Resmi & Ekosistem -->
            <div>
                <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Mitra &amp; Tautan Resmi</h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="https://dicoding.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Dicoding Indonesia</a></li>
                    <li><a href="https://skillsbuild.org" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">IBM SkillsBuild Global</a></li>
                    <li><a href={pijak2027.faqLink} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Dokumen FAQ Resmi Pijak</a></li>
                    <li><a href="mailto:pijak@dicoding.com" class="hover:text-white transition-colors">Kontak Email: pijak@dicoding.com</a></li>
                    <li><a href={pijak2027.ctaLink} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors font-bold text-primary">Daftar Beasiswa Pijak &rarr;</a></li>
                </ul>
            </div>

        </div>

        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 text-center sm:text-left">
            <p>© 2026–2027 Beasiswa Coding Indonesia. Dikurasi bersama ekosistem Dicoding &amp; mitra teknologi global.</p>
            <p class="text-[11px] text-slate-600">
                Pendaftaran resmi dilakukan aman melalui platform Dicoding.com.
            </p>
        </div>

    </div>
</footer>
