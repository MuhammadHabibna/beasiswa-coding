---
import { pijak2027 } from '../data/programs';
---
<footer class="bg-[#0c111d] border-t border-slate-800 text-slate-400 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 lg:py-16">
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-slate-800/80">
            
            <!-- Col 1: Brand -->
            <div class="md:col-span-2 space-y-3">
                <div class="flex items-center space-x-2">
                    <img src="/images/icon.jpg" alt="Dicoding" class="w-7 h-7 rounded-lg object-cover" />
                    <span class="text-xl font-extrabold text-white tracking-tight">dicoding <span class="text-primary font-normal">pijak</span></span>
                </div>
                <p class="text-xs text-slate-400 max-w-sm leading-relaxed font-normal">
                    Program beasiswa resmi kolaborasi antara IBM SkillsBuild dan Dicoding Indonesia untuk mencetak 60.000 AI-Native Web Developer terdepan di Indonesia.
                </p>
                <div class="pt-2 text-xs text-slate-500">
                    Batas Pendaftaran: <span class="text-white font-semibold">{pijak2027.deadline}</span>
                </div>
            </div>

            <!-- Col 2: Navigasi -->
            <div>
                <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Navigasi Halaman</h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="#tentang" class="hover:text-white transition-colors">Tentang Pijak 2027</a></li>
                    <li><a href="#benefit" class="hover:text-white transition-colors">Benefit Beasiswa</a></li>
                    <li><a href="#path" class="hover:text-white transition-colors">Kurikulum Belajar</a></li>
                    <li><a href="#prasyarat" class="hover:text-white transition-colors">Prasyarat &amp; Perangkat</a></li>
                    <li><a href="#timeline" class="hover:text-white transition-colors">Timeline Jadwal</a></li>
                    <li><a href="#seleksi" class="hover:text-white transition-colors">Tahapan Seleksi</a></li>
                    <li><a href="#gamifikasi" class="hover:text-white transition-colors">Hadiah &amp; Komunitas</a></li>
                </ul>
            </div>

            <!-- Col 3: Link Resmi -->
            <div>
                <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Tautan Resmi</h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="https://dicoding.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Dicoding Indonesia</a></li>
                    <li><a href={pijak2027.faqLink} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Dokumen FAQ Resmi</a></li>
                    <li><a href="https://skillsbuild.org" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">IBM SkillsBuild Global</a></li>
                    <li><a href="mailto:pijak@dicoding.com" class="hover:text-white transition-colors">pijak@dicoding.com</a></li>
                    <li><a href="https://www.linkedin.com/company/pijak-in-collaboration-with-ibm-skillsbuild/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LinkedIn Pijak</a></li>
                </ul>
            </div>

        </div>

        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 text-center sm:text-left">
            <p>© 2026–2027 Pijak in collaboration with IBM SkillsBuild &amp; Dicoding Indonesia. All Rights Reserved.</p>
            <p class="text-[11px] text-slate-600">
                Pendaftaran resmi dilakukan aman melalui platform Dicoding.com.
            </p>
        </div>

    </div>
</footer>
