---
import { pijak2027 } from '../data/programs';
const { tracks } = pijak2027;
---

<section id="path" class="bg-white py-20 px-4 relative overflow-hidden border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto fade-in-up relative z-10 px-2 sm:px-4">
        
        <div class="text-center mb-16 max-w-2xl mx-auto">
            <div class="badge-pill-blue mb-3">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                Struktur Kurikulum Pijak 2027
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-dark-slate tracking-tight mb-3">
                Jalur Belajar &amp; Kurikulum Berstandar Global
            </h2>
            <p class="text-subtle text-base sm:text-lg leading-relaxed">
                Pilih atau ikuti alur program yang dirancang terstruktur mulai dari pemahaman fondasi AI hingga penguasaan aplikasi web skala industri dengan IBM Agentic Coding.
            </p>
        </div>

        <div class="space-y-10">
            
            <!-- Grid: Pemula & Progresif -->
            <div class="grid lg:grid-cols-2 gap-7">
                
                <!-- Track 1: Beasiswa Pemula -->
                <div class="bg-slate-50/70 rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-xs hover:shadow-md hover:border-blue-200 transition-all duration-200 flex flex-col justify-between group">
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-4">
                            <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-blue-50 text-primary border border-blue-200/60">
                                Tahap 1 • Fondasi
                            </span>
                            <span class="text-xs font-semibold text-slate-500">Semua Pendaftar</span>
                        </div>

                        <h3 class="text-2xl font-extrabold text-dark-slate mb-2">Beasiswa Pemula</h3>
                        <p class="text-subtle text-sm leading-relaxed mb-6 font-normal">
                            Fondasi esensial yang membekali Anda dengan pemahaman mendalam dasar AI, etika, dan produktivitas sebelum melangkah ke jenjang berikutnya.
                        </p>

                        <!-- Courses List -->
                        <div class="space-y-4">
                            {tracks[0].courses.map((courseGroup) => (
                                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs">
                                    <h4 class="text-xs font-bold uppercase tracking-wider text-primary mb-3 flex items-center gap-2">
                                        <div class="w-5 h-5 rounded bg-blue-50 flex items-center justify-center text-primary shrink-0">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                                        </div>
                                        {courseGroup.category}
                                    </h4>
                                    <ul class="space-y-2 text-xs font-medium text-slate-700">
                                        {courseGroup.items.map((item) => (
                                            <li class="flex items-start gap-2">
                                                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                                <span>{item}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                        </div>
                    </div>

                    <div class="mt-6 pt-4 border-t border-slate-200 text-xs text-slate-500 flex items-center justify-between font-medium">
                        <span>Format: Self-paced Online</span>
                        <span class="font-bold text-primary">Selesai sebelum 31 Des 2026</span>
                    </div>
                </div>

                <!-- Track 3: Beasiswa Progresif -->
                <div class="bg-slate-50/70 rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-xs hover:shadow-md hover:border-amber-200 transition-all duration-200 flex flex-col justify-between group">
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-4">
                            <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-amber-50 text-amber-800 border border-amber-200/60">
                                Jalur Umum &amp; Profesional
                            </span>
                            <span class="text-xs font-semibold text-slate-500">Self-Paced Learning</span>
                        </div>

                        <h3 class="text-2xl font-extrabold text-dark-slate mb-2">Beasiswa Progresif</h3>
                        <p class="text-subtle text-sm leading-relaxed mb-6 font-normal">
                            Jalur pembelajaran mandiri fleksibel bagi kalangan umum dan profesional untuk akselerasi kecakapan AI aplikatif dan pengembangan frontend React.
                        </p>

                        <!-- Courses List -->
                        <div class="space-y-4">
                            {tracks[2].courses.map((courseGroup) => (
                                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs">
                                    <h4 class="text-xs font-bold uppercase tracking-wider text-amber-800 mb-3 flex items-center gap-2">
                                        <div class="w-5 h-5 rounded bg-amber-50 flex items-center justify-center text-amber-700 shrink-0">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                        </div>
                                        {courseGroup.category}
                                    </h4>
                                    <ul class="space-y-2 text-xs font-medium text-slate-700">
                                        {courseGroup.items.map((item) => (
                                            <li class="flex items-start gap-2">
                                                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                                <span>{item}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                        </div>
                    </div>

                    <div class="mt-6 pt-4 border-t border-slate-200 text-xs text-slate-500 flex items-center justify-between font-medium">
                        <span>Format: Belajar Mandiri di Dicoding</span>
                        <span class="font-bold text-amber-700">Akses Fleksibel</span>
                    </div>
                </div>

            </div>

            <!-- Featured: Track 2 (Beasiswa Intensif) with Dicoding Deep Brand Navy -->
            <div class="bg-[#101828] rounded-2xl p-6 sm:p-10 text-white shadow-xl relative overflow-hidden group border border-slate-800">
                <div class="absolute -top-32 -right-32 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative z-10">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
                        <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 border border-blue-400/30">
                            ★ Program Unggulan • Beasiswa Intensif
                        </span>
                        <span class="text-xs font-semibold text-slate-300 bg-white/10 px-3 py-1 rounded-full">
                            Khusus Murid SMK &amp; Mahasiswa Vokasi Aktif
                        </span>
                    </div>

                    <div class="max-w-3xl mb-8">
                        <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight mb-3 text-white">
                            Beasiswa Intensif: Menjadi AI-Native Web Developer
                        </h3>
                        <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-normal">
                            Program lanjutan eksklusif bagi lulusan terpilih Beasiswa Pemula. Dibekali kurikulum teknis web development dari dasar hingga mahir, materi soft skills esensial, bimbingan rutin instruktur expert, dan tugas akhir berkelompok dengan dukungan <strong class="text-white underline decoration-blue-400 font-bold">IBM Agentic Coding</strong>.
                        </p>
                    </div>

                    <!-- 3 Column details: Teknis, Bonus/Non-Teknis, Capstone -->
                    <div class="grid md:grid-cols-3 gap-6 mb-8 text-dark-slate">
                        
                        <!-- Col 1: Kelas Teknis -->
                        <div class="bg-white rounded-xl p-5 shadow-xs flex flex-col justify-between border border-slate-200">
                            <div>
                                <h4 class="text-xs font-bold uppercase tracking-wider text-primary mb-3 flex items-center gap-1.5">
                                    <span class="w-2 h-2 rounded-full bg-primary"></span>
                                    Kelas Teknis Utama
                                </h4>
                                <ul class="space-y-2 text-xs font-semibold text-slate-700">
                                    {tracks[1].courses[0].items.map((it) => (
                                        <li class="flex items-start gap-2">
                                            <svg class="w-3.5 h-3.5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                            <span>{it}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                            <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-primary font-bold">
                                7 Modul Teknis Lengkap
                            </div>
                        </div>

                        <!-- Col 2: Bonus & Soft Skills -->
                        <div class="bg-white rounded-xl p-5 shadow-xs flex flex-col justify-between border border-slate-200">
                            <div>
                                <h4 class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-2 flex items-center gap-1.5">
                                    <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
                                    Bonus Kelas (*S&amp;K)
                                </h4>
                                <ul class="space-y-1.5 text-xs font-semibold text-slate-700 mb-4">
                                    {tracks[1].bonus && tracks[1].bonus.map((b) => (
                                        <li class="flex items-start gap-2">
                                            <span class="text-indigo-600 font-bold">+</span>
                                            <span>{b}</span>
                                        </li>
                                    ))}
                                </ul>

                                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-2 flex items-center gap-1.5 border-t border-slate-100 pt-3">
                                    <span class="w-2 h-2 rounded-full bg-slate-500"></span>
                                    Materi Non-Teknis (Soft Skills)
                                </h4>
                                <ul class="space-y-1 text-[11px] text-slate-600">
                                    {tracks[1].nonTechnical && tracks[1].nonTechnical.slice(0, 4).map((nt) => (
                                        <li class="truncate">• {nt}</li>
                                    ))}
                                    <li class="text-[10px] text-primary font-bold">+ 2 Modul Soft Skills Lainnya</li>
                                </ul>
                            </div>
                            <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-indigo-700 font-bold">
                                Kesiapan Karier Komprehensif
                            </div>
                        </div>

                        <!-- Col 3: Capstone & Mentoring -->
                        <div class="bg-white rounded-xl p-5 shadow-xs flex flex-col justify-between border border-slate-200">
                            <div>
                                <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-800 mb-3 flex items-center gap-1.5">
                                    <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                                    Tugas Akhir Berkelompok
                                </h4>
                                <div class="p-3 bg-emerald-50 rounded-lg border border-emerald-100 mb-4 text-xs text-slate-700 leading-relaxed font-normal">
                                    {tracks[1].capstone}
                                </div>

                                <div class="space-y-2 text-xs font-bold text-slate-700">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        <span>Bimbingan Rutin bersama Expert</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        <span>Showcase Proyek Solusi Nyata</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        <span>Transkrip Nilai &amp; Sertifikat Resmi</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-emerald-700 font-bold">
                                Periode: Februari – Juni 2027
                            </div>
                        </div>

                    </div>

                    <!-- Bottom CTA banner -->
                    <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-800">
                        <p class="text-xs text-slate-400 font-medium">
                            *Peserta intensif wajib menyelesaikan Beasiswa Pemula &amp; lolos tes penilaian sebelum 31 Desember 2026.
                        </p>
                        <a href={pijak2027.ctaLink} target="_blank" rel="noopener noreferrer" class="btn-dicoding-primary text-xs font-bold px-6 py-3 shrink-0">
                            Daftar Sekarang untuk Akses Seleksi
                            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>
                    </div>
                </div>
            </div>

        </div>

    </div>
</section>
