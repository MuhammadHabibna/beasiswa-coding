---
import type { CatalogProgram } from '../data/programs';

interface Props extends CatalogProgram {}

const { 
  title, 
  subtitle, 
  partner, 
  status, 
  statusBadge, 
  statusColor = 'emerald', 
  quota, 
  description, 
  tags, 
  features, 
  ctaLink, 
  ctaText, 
  detailsLink, 
  image, 
  deadline, 
  isFeatured = false 
} = Astro.props;

const isOpen = status === 'open';

const statusBadgeClasses = {
  emerald: 'bg-emerald-50 text-emerald-700 border-emerald-200/80',
  amber: 'bg-amber-50 text-amber-700 border-amber-200/80',
  blue: 'bg-blue-50 text-blue-700 border-blue-200/80',
  purple: 'bg-purple-50 text-purple-700 border-purple-200/80'
}[statusColor] || 'bg-slate-100 text-slate-700 border-slate-200';
---

<div class={`flex flex-col mx-auto w-full rounded-2xl border transition-all duration-300 relative bg-white overflow-hidden group ${
  isFeatured 
    ? 'border-blue-400/90 shadow-md ring-1 ring-blue-300/50 hover:shadow-lg hover:border-blue-500' 
    : 'border-slate-200/90 shadow-xs hover:shadow-md hover:border-slate-300'
}`}>
  
  <!-- Image Banner -->
  <div class="relative h-44 sm:h-48 w-full overflow-hidden bg-slate-100">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
      loading="lazy" 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
    
    <!-- Top Badges -->
    <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2">
      <!-- Status Badge -->
      <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold border backdrop-blur-md shadow-xs ${statusBadgeClasses}`}>
        {isOpen && <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>}
        {statusBadge}
      </span>
      
      <!-- Deadline Badge -->
      <span class="text-[10px] font-semibold text-white/95 bg-black/50 backdrop-blur-md px-2.5 py-1 rounded-full border border-white/20">
        {deadline}
      </span>
    </div>

    <!-- Partner Title on Image Bottom -->
    <div class="absolute bottom-3 left-3 right-3 text-white">
      <span class="text-[11px] font-bold uppercase tracking-wider text-blue-200 drop-shadow-xs">
        {partner}
      </span>
    </div>
  </div>

  <!-- Content Body -->
  <div class="p-5 sm:p-6 flex flex-col flex-grow">
    
    <!-- Title & Quota -->
    <div class="flex items-start justify-between gap-2 mb-1.5">
      <h3 class="text-xl font-extrabold text-dark-slate tracking-tight group-hover:text-primary transition-colors">
        {title}
      </h3>
    </div>

    <p class="text-xs font-semibold text-slate-500 mb-3.5">
      {subtitle}
    </p>

    <!-- Quota Strip -->
    <div class="mb-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-50 border border-slate-200 text-xs font-bold text-slate-700 w-fit">
      <svg class="w-3.5 h-3.5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      {quota}
    </div>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {tags.map((tag) => (
        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 border border-slate-200">
          {tag}
        </span>
      ))}
    </div>

    <!-- Description -->
    <p class="text-subtle text-xs sm:text-sm leading-relaxed mb-5">
      {description}
    </p>

    <!-- Features -->
    <ul class="mb-6 space-y-2 text-left mt-auto pt-4 border-t border-slate-100">
      {features.map((feature) => (
        <li class="flex items-start gap-2 text-xs text-slate-600 font-medium">
          <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span>{feature}</span>
        </li>
      ))}
    </ul>

    <!-- Action Buttons -->
    <div class="pt-2 flex flex-col gap-2">
      {isOpen ? (
        <a 
          href={ctaLink} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-dicoding-primary text-xs sm:text-sm py-3 px-4 w-full shadow-xs text-center justify-center font-bold"
        >
          <span>{ctaText}</span>
          <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      ) : (
        <a 
          href={detailsLink} 
          class="btn-dicoding-secondary text-xs sm:text-sm py-2.5 px-4 w-full text-center justify-center font-semibold text-slate-600"
        >
          <span>{ctaText}</span>
        </a>
      )}

      {isFeatured && (
        <a 
          href="#tentang" 
          class="text-[11px] font-bold text-center text-primary hover:text-blue-700 transition-colors py-1"
        >
          Pelajari Detail Kurikulum &amp; Prasyarat &darr;
        </a>
      )}
    </div>

  </div>
</div>
