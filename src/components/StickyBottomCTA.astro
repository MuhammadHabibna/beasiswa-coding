---
import { pijak2027 } from '../data/programs';
---

<div class="fixed bottom-0 left-0 z-50 w-full p-3 sm:p-4 bg-white/95 backdrop-blur-md border-t border-slate-200/90 md:hidden pb-[env(safe-area-inset-bottom)] shadow-[0_-4px_16px_rgba(0,0,0,0.06)] transition-all">
    <div class="flex items-center gap-3 max-w-lg mx-auto">
        <div class="flex flex-col shrink-0">
            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Pijak 2027</span>
            <span class="text-xs font-black text-primary">100% Gratis</span>
        </div>
        <a href={pijak2027.ctaLink} target="_blank" rel="noopener noreferrer" class="btn-dicoding-primary flex-1 py-3 px-4 text-xs sm:text-sm font-extrabold shadow-sm">
            <span>Daftar Beasiswa Sekarang</span>
            <svg class="w-3.5 h-3.5 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
    </div>
</div>
