---
import { pijak2027 } from '../data/programs';
---
<nav class="fixed w-full z-50 top-0 start-0 border-b border-slate-200/80 bg-white/90 backdrop-blur-md transition-all duration-200">
  <div class="max-w-7xl flex flex-wrap items-center justify-between mx-auto px-4 sm:px-6 py-3.5">
    <!-- Brand -->
    <a href="#" class="flex items-center space-x-3 rtl:space-x-reverse z-50 relative group outline-none">
        <div class="relative overflow-hidden rounded-xl shadow-xs border border-slate-200 bg-white p-0.5 group-hover:border-blue-400 transition-all duration-200">
            <img src="/images/pijak_logo.svg" alt="Beasiswa Coding Logo" class="w-9 h-9 rounded-lg object-contain group-hover:scale-105 transition-transform duration-300" />
        </div>
        <div class="flex flex-col">
            <div class="flex items-center gap-1.5">
                <span class="font-extrabold text-lg text-dark-slate tracking-tight leading-none">
                    beasiswa
                </span>
                <span class="font-extrabold text-lg text-primary tracking-tight leading-none">
                    coding
                </span>
                <span class="text-[10px] font-extrabold bg-blue-50 text-primary border border-blue-200/80 px-2 py-0.5 rounded-full uppercase tracking-wider hidden sm:inline">
                    Portal IT
                </span>
            </div>
            <span class="text-[11px] font-semibold text-slate-500 tracking-tight">Portal Beasiswa Coding &amp; AI Indonesia</span>
        </div>
    </a>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" type="button" class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-slate-500 rounded-xl md:hidden hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-100 z-50 relative transition-all" aria-controls="navbar-default" aria-expanded="false" aria-label="Toggle navigation">
        <span class="sr-only">Buka menu navigasi</span>
        <svg class="w-5 h-5 hamburger-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
        </svg>
        <svg class="w-5 h-5 close-icon hidden scale-75 opacity-0 transition-all" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
        </svg>
    </button>

    <!-- Desktop Menu -->
    <div class="hidden w-full md:block md:w-auto" id="navbar-desktop">
      <ul class="font-medium flex flex-col p-4 md:p-0 mt-4 border border-slate-100 rounded-xl md:flex-row md:space-x-6 rtl:space-x-reverse md:mt-0 md:border-0 items-center text-sm">
        <li>
          <a href="#programs" class="text-slate-600 hover:text-primary transition-colors py-1.5 font-semibold">Program Beasiswa</a>
        </li>
        <li>
          <a href="#tentang" class="text-slate-600 hover:text-primary transition-colors py-1.5 font-semibold">Pijak 2027</a>
        </li>
        <li>
          <a href="#path" class="text-slate-600 hover:text-primary transition-colors py-1.5 font-semibold">Kurikulum</a>
        </li>
        <li>
          <a href="#benefit" class="text-slate-600 hover:text-primary transition-colors py-1.5 font-semibold">Benefit</a>
        </li>
        <li>
          <a href="#prasyarat" class="text-slate-600 hover:text-primary transition-colors py-1.5 font-semibold">Prasyarat</a>
        </li>
        <li>
          <a href="#faq" class="text-slate-600 hover:text-primary transition-colors py-1.5 font-semibold">FAQ</a>
        </li>
        <li class="pl-1">
          <a href={pijak2027.ctaLink} target="_blank" rel="noopener noreferrer" class="btn-dicoding-primary text-xs font-bold px-4 py-2.5 shadow-xs">
             <span>Daftar Beasiswa Aktif</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Mobile Drawer Overlay -->
  <div id="mobile-drawer" class="fixed inset-0 z-40 bg-white transform translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col pt-24 px-6 pb-8 shadow-2xl overflow-y-auto">
      <ul class="flex flex-col space-y-3 text-base font-bold w-full">
        <li>
          <a href="#programs" class="mobile-link flex items-center justify-between py-3 px-4 rounded-xl text-slate-800 hover:bg-slate-50 hover:text-primary transition-all">
              <span>Katalog Beasiswa</span>
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </li>
        <li>
          <a href="#tentang" class="mobile-link flex items-center justify-between py-3 px-4 rounded-xl text-slate-800 hover:bg-slate-50 hover:text-primary transition-all">
              <span>Program Aktif (Pijak 2027)</span>
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </li>
        <li>
          <a href="#path" class="mobile-link flex items-center justify-between py-3 px-4 rounded-xl text-slate-800 hover:bg-slate-50 hover:text-primary transition-all">
              <span>Alur &amp; Kurikulum Belajar</span>
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </li>
        <li>
          <a href="#benefit" class="mobile-link flex items-center justify-between py-3 px-4 rounded-xl text-slate-800 hover:bg-slate-50 hover:text-primary transition-all">
              <span>Benefit Beasiswa</span>
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </li>
        <li>
          <a href="#prasyarat" class="mobile-link flex items-center justify-between py-3 px-4 rounded-xl text-slate-800 hover:bg-slate-50 hover:text-primary transition-all">
              <span>Syarat &amp; Perangkat</span>
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </li>
        <li>
          <a href="#faq" class="mobile-link flex items-center justify-between py-3 px-4 rounded-xl text-slate-800 hover:bg-slate-50 hover:text-primary transition-all">
              <span>FAQ / Tanya Jawab</span>
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </li>
      </ul>
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </li>
        <li>
          <a href="#faq" class="mobile-link flex items-center justify-between py-3 px-4 rounded-xl text-slate-800 hover:bg-slate-50 hover:text-primary transition-all">
              <span>FAQ</span>
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </li>
        <li class="pt-3">
          <a href={pijak2027.ctaLink} target="_blank" rel="noopener noreferrer" class="mobile-link btn-dicoding-primary w-full py-3.5 px-4 text-sm font-extrabold shadow-sm">
              <span>Daftar Pijak 2027 Sekarang</span>
          </a>
        </li>
      </ul>
      
      <div class="mt-auto items-center justify-center flex flex-col space-y-2 pt-6 border-t border-slate-100 text-center">
           <p class="text-xs font-semibold text-slate-500">Pijak 2027 • IBM SkillsBuild &amp; Dicoding</p>
      </div>
  </div>
</nav>

<script>
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const hamburgerIcon = document.querySelector('.hamburger-icon');
    const closeIcon = document.querySelector('.close-icon');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    if (btn && drawer && hamburgerIcon && closeIcon) {
        btn.addEventListener('click', () => {
            const isExpanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', !isExpanded);
            drawer.classList.toggle('translate-x-full');
            hamburgerIcon.classList.toggle('hidden');
            closeIcon.classList.toggle('hidden');
            document.body.classList.toggle('overflow-hidden');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                drawer.classList.add('translate-x-full');
                btn.setAttribute('aria-expanded', 'false');
                hamburgerIcon.classList.remove('hidden');
                closeIcon.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            });
        });
    }
</script>
