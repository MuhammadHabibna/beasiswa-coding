---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AboutProgram from '../components/AboutProgram.astro';
import Benefits from '../components/Benefits.astro';
import LearningPaths from '../components/LearningPaths.astro';
import Requirements from '../components/Requirements.astro';
import Timeline from '../components/Timeline.astro';
import SelectionProcess from '../components/SelectionProcess.astro';
import Gamification from '../components/Gamification.astro';
import Certificates from '../components/Certificates.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
    title="Jadi AI-Native Web Developer bersama Pijak 2027 - Dicoding & IBM SkillsBuild"
    description="Beasiswa Pijak 2027 dari IBM SkillsBuild dan Dicoding membuka kesempatan bagi 60.000 talenta Indonesia untuk mengembangkan keterampilan praktis di bidang Artificial Intelligence (AI) dan Web Development."
>
	<Navbar />
    <main>
        <Hero />
        <AboutProgram />
        <Benefits />
        <LearningPaths />
        <Requirements />
        <Timeline />
        <SelectionProcess />
        <Gamification />
        <Certificates />
        <FAQ />
        <CTABand />
    </main>
    <Footer />
</Layout>
