---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Programs from '../components/Programs.astro';
import DigitalProducts from '../components/DigitalProducts.astro';
import AboutProgram from '../components/AboutProgram.astro';
import Benefits from '../components/Benefits.astro';
import LearningPaths from '../components/LearningPaths.astro';
import Requirements from '../components/Requirements.astro';
import Timeline from '../components/Timeline.astro';
import SelectionProcess from '../components/SelectionProcess.astro';
import Gamification from '../components/Gamification.astro';
import Certificates from '../components/Certificates.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
    title="Beasiswa Coding Indonesia - Portal Beasiswa IT & AI Terbuka 2027"
    description="Portal direktori dan informasi resmi beasiswa coding, AI, dan pelatihan teknologi gratis berstandar industri global di Indonesia. Temukan program beasiswa aktif seperti Pijak 2027 x IBM SkillsBuild dan raih karier digital impianmu."
>
	<Navbar />
    <main>
        <Hero />
        <Programs />
        <DigitalProducts />
        <AboutProgram />
        <Benefits />
        <LearningPaths />
        <Requirements />
        <Timeline />
        <SelectionProcess />
        <Gamification />
        <Certificates />
        <FAQ />
        <CTABand />
    </main>
    <Footer />
</Layout>
